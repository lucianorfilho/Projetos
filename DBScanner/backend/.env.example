# Modo de operação: demo (schema simulado) ou oracle (banco real)
DBSCANNER_MODE=demo

# Porta da API
PORT=4200

# Conexão Oracle (apenas para DBSCANNER_MODE=oracle)
# Usuário precisa de SELECT_CATALOG_ROLE (ou os grants do README)
ORACLE_USER=dbscanner_ro
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=host:1521/SERVICE

# Schema alvo do scan (default: o próprio usuário conectado)
ORACLE_TARGET_SCHEMA=
