# Porta da API do DBView
PORT=4100

# MySQL (cadastro de clientes e instâncias)
DB_HOST=localhost
DB_PORT=3306
DB_USER=dbview
DB_PASSWORD=
DB_NAME=dbview

# Segredo do JWT (gere um valor forte em produção)
JWT_SECRET=troque-este-segredo

# Modo de coleta: "demo" (simulador, sem Oracle) ou "oracle" (conexão real)
DBVIEW_MODE=demo

# Plano do cliente: "free" (1 instância) ou "pro" (até 5 instâncias)
DBVIEW_PLAN=pro

# Intervalo de coleta em segundos
COLLECT_INTERVAL=5

# Conexão Oracle (usada quando DBVIEW_MODE=oracle)
# O driver roda em modo "thin" — não precisa de Oracle Instant Client instalado.
ORACLE_USER=dbview_mon
ORACLE_PASSWORD=
# Formato: host:porta/service_name  (ex.: 192.168.0.10:1521/ORCLPDB1)
ORACLE_CONNECT_STRING=localhost:1521/ORCLPDB1

# Dias de antecedência para alertar sobre senha expirando
PASSWORD_EXPIRY_WARN_DAYS=15
