# ============================================
# DBVendas Backend Environment Variables
# ============================================
# IMPORTANTE: Copie este arquivo para .env e preencha com seus valores!
# NEVER commit .env com valores reais para o git

# ============================================
# SECURITY - CRITICAL
# ============================================
# Gere uma nova SECRET_KEY com:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=YOUR_SECURE_SECRET_KEY_HERE_MIN_32_CHARS

# Ambiente: development, staging, production
DEBUG=false

# ============================================
# DATABASE - CRITICAL
# ============================================
# Format: postgresql://username:password@host:port/database
# NUNCA use user/password padrão em produção!
DATABASE_URL=postgresql://dbvendas:STRONG_PASSWORD_HERE@localhost:5432/dbvendas

# ============================================
# TOKEN SECURITY
# ============================================
# Tempo de expiração do token JWT em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# CORS - Allowed Origins
# ============================================
# Separar múltiplos origins com vírgula
CORS_ORIGINS=https://cardapio.dbvendas.dbtechsolutions.com.br,https://dbvendas.dbtechsolutions.com.br

# ============================================
# RATE LIMITING
# ============================================
# Format: requests/time_window (e.g., "5/minute", "3/hour")
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/hour

# ============================================
# LOGGING
# ============================================
# Níveis: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================
# REDIS (for token blacklist, caching, sessions)
# ============================================
REDIS_URL=redis://localhost:6379/0
