# Porta do backend
PORT=4300

# Motor de diálogo: "local" (funciona sem chave) ou "claude" (requer ANTHROPIC_API_KEY)
# Se ANTHROPIC_API_KEY estiver preenchida, o modo "claude" é usado automaticamente.
ENGINE=local

# Chave da API Anthropic (opcional — deixa o tutor muito mais inteligente)
ANTHROPIC_API_KEY=

# Modelo Claude a usar quando ENGINE=claude
CLAUDE_MODEL=claude-opus-4-8

# ---- Pague e use (valores em centavos de R$) ----
BILLING_ENABLED=true
PRICE_MESSAGE_CENTS=5          # R$ 0,05 por mensagem de conversa
PRICE_PRONUNCIATION_CENTS=3    # R$ 0,03 por avaliação de pronúncia
WELCOME_BONUS_CENTS=200        # R$ 2,00 de bônus para novos alunos
