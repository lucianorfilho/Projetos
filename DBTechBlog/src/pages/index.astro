---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import HeroArt from '../components/HeroArt.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);

const products = [
	{
		slug: 'dbvault',
		name: 'DBVault',
		tag: 'Backup na nuvem',
		desc: 'Gerenciamento de backups de banco de dados na nuvem, com alertas de vencimento e armazenamento OCI.',
	},
	{
		slug: 'dbscanner',
		name: 'DBScanner',
		tag: 'Análise de Schema',
		desc: 'Analisador de schema Oracle: catálogo pesquisável e base de conhecimento do banco.',
	},
	{
		slug: 'dbview',
		name: 'DBView',
		tag: 'Raio-X de Oracle',
		desc: 'Visão rápida de saúde e estrutura de um banco Oracle, direto do navegador.',
	},
	{
		slug: 'dbwatch',
		name: 'DBWatch',
		tag: 'Monitoramento desktop',
		desc: 'Monitor desktop para múltiplas instâncias Oracle: status do banco, SO e backup.',
	},
];
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-text">
					<h1>Banco de dados, monitoramento<br />e segurança, sem mistério.</h1>
					<p>
						Artigos, scripts e soluções reais de administração de banco de dados, monitoramento de
						infraestrutura e segurança — e os produtos que nascem dessas soluções.
					</p>
					<div class="hero-ctas">
						<a class="btn btn-primary" href="/blog">Ler o blog</a>
						<a class="btn btn-ghost" href="/produtos">Ver produtos</a>
					</div>
				</div>
				<div class="hero-art" aria-hidden="true">
					<HeroArt />
				</div>
			</section>

			<section class="products">
				<h2>Produtos</h2>
				<div class="grid-3">
					{
						products.map((p) => (
							<a class="product-card" href={`/produtos/${p.slug}`}>
								<span class="tag">{p.tag}</span>
								<h3>{p.name}</h3>
								<p>{p.desc}</p>
								<span class="link">Saiba mais →</span>
							</a>
						))
					}
				</div>
			</section>

			<section class="latest-posts">
				<div class="section-head">
					<h2>Últimos posts</h2>
					<a href="/blog">Ver todos →</a>
				</div>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<h4>{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<p class="desc">{post.data.description}</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		display: flex;
		align-items: center;
		gap: 2em;
		padding: 2em 0 3em;
	}
	.hero-text {
		flex: 1.15;
		min-width: 0;
	}
	.hero-art {
		flex: 1;
		max-width: 300px;
	}
	.hero-art svg {
		width: 100%;
		height: auto;
		display: block;
	}
	.hero h1 {
		font-size: 2.3rem;
		letter-spacing: -0.02em;
	}
	.hero p {
		color: rgb(var(--gray));
		font-size: 1.05rem;
		margin: 1em 0 1.5em;
	}
	.hero-ctas {
		display: flex;
		gap: 0.75em;
	}
	.btn {
		display: inline-block;
		padding: 0.7em 1.4em;
		border-radius: 8px;
		font-weight: 600;
		text-decoration: none;
		font-size: 0.95rem;
	}
	.btn-primary {
		background: var(--accent);
		color: #fff;
	}
	.btn-ghost {
		border: 1px solid var(--border);
		color: rgb(var(--black));
	}

	.products h2,
	.latest-posts h2 {
		font-size: 1.6rem;
	}
	.grid-3 {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.1rem;
		margin: 1.3em 0 3em;
	}
	.product-card {
		display: block;
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 1.5em;
		text-decoration: none;
		color: inherit;
	}
	.product-card:hover {
		border-color: var(--accent);
	}
	.product-card .tag {
		font-size: 0.72rem;
		font-weight: 700;
		color: var(--accent);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.product-card h3 {
		margin: 0.4em 0 0.3em;
		font-size: 1.15rem;
	}
	.product-card p {
		color: rgb(var(--gray));
		font-size: 0.9rem;
		margin: 0 0 0.8em;
	}
	.product-card .link {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--accent);
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
	}
	.section-head a {
		font-size: 0.9rem;
		text-decoration: none;
	}
	.latest-posts ul {
		list-style: none;
		margin: 1.2em 0 0;
		padding: 0;
	}
	.latest-posts li {
		border-top: 1px solid var(--border);
	}
	.latest-posts li:last-child {
		border-bottom: 1px solid var(--border);
	}
	.latest-posts a {
		display: block;
		padding: 1.1em 0;
		text-decoration: none;
		color: inherit;
	}
	.latest-posts h4 {
		margin: 0 0 0.2em;
		font-size: 1.1rem;
		color: rgb(var(--black));
	}
	.latest-posts a:hover h4 {
		color: var(--accent);
	}
	.latest-posts .date {
		color: rgb(var(--gray));
		font-size: 0.82rem;
		margin: 0 0 0.3em;
	}
	.latest-posts .desc {
		color: rgb(var(--gray));
		font-size: 0.92rem;
		margin: 0;
	}

	@media (max-width: 720px) {
		.grid-3 {
			grid-template-columns: 1fr;
		}
		.hero {
			flex-direction: column-reverse;
			text-align: center;
			gap: 1em;
		}
		.hero-art {
			flex: none;
			width: 100%;
			max-width: 220px;
			margin: 0 auto;
		}
		.hero-ctas {
			justify-content: center;
		}
		.hero h1 {
			font-size: 2rem;
		}
	}
</style>
